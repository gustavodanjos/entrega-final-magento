<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="product.info.media" remove="true" />
        <referenceBlock name="product.info.options.wrapper" remove="true" />

        <referenceContainer name="content">
            <block class="Nuvem\AtelieStudio\Block\Studio"
                   name="atelie.studio.container"
                   template="Nuvem_AtelieStudio::studio.phtml"
                   before="-">
                <arguments>
                    <argument name="view_model" xsi:type="object">Nuvem\AtelieStudio\ViewModel\Estudio</argument>
                    <argument name="jsLayout" xsi:type="array">
                        <item name="components" xsi:type="array">
                            <item name="atelieStudio" xsi:type="array">
                                <item name="component" xsi:type="string">Nuvem_AtelieStudio/js/studio</item>
                            </item>
                        </item>
                    </argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
