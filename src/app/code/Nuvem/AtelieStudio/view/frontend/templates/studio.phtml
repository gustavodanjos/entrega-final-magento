<script>
(function () {
    'use strict';
    function sanitizeNavA11y() {
        var selector = '.nav-sections, .nav-sections-items, .nav-sections-item-title, '
            + '.nav-sections-item-content, .navigation, .navigation ul, .navigation li, .navigation a';
        var badRoles = ['menu', 'menubar', 'menuitem', 'presentation', 'tablist', 'tab', 'tabpanel'];
        var elements = document.querySelectorAll(selector);
        for (var i = 0; i < elements.length; i++) {
            var el = elements[i];
            var role = el.getAttribute('role');
            if (role && badRoles.indexOf(role) !== -1) {
                el.removeAttribute('role');
            }
            if (el.hasAttribute('aria-selected')) {
                el.removeAttribute('aria-selected');
            }
        }
        var searchInput = document.getElementById('search');
        if (searchInput && searchInput.getAttribute('aria-haspopup') === 'false') {
            searchInput.removeAttribute('aria-haspopup');
        }
    }

    sanitizeNavA11y();
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', sanitizeNavA11y);
    }
    window.addEventListener('load', sanitizeNavA11y);

    if (typeof window.MutationObserver !== 'undefined') {
        var isRunning = false;
        var observer = new MutationObserver(function () {
            if (isRunning) return;
            isRunning = true;
            sanitizeNavA11y();
            isRunning = false;
        });
        var navContainer = document.querySelector('.nav-sections') || document.body;
        if (navContainer) {
            observer.observe(navContainer, {
                attributes: true,
                attributeFilter: ['role'],
                subtree: true
            });
        }
    }
})();
</script>
