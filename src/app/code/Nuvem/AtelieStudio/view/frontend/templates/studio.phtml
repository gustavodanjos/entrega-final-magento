<?php
/**
 * @var \Nuvem\AtelieStudio\Block\Studio $block
 * @var \Nuvem\AtelieStudio\ViewModel\Estudio $viewModel
 */
$viewModel = $block->getData('view_model');
$jsLayout = $viewModel
    ? $viewModel->getMergedJsLayout($block->getJsLayout())
    : $block->getJsLayout();

$svgContent = '';
$svgPath = $block->getViewFileUrl('Nuvem_AtelieStudio::images/camadas/tenis-completo.svg');
$svgFile = BP . '/pub/' . ltrim((string) parse_url($svgPath, PHP_URL_PATH), '/');

if (is_file($svgFile)) {
    $svgContent = (string) file_get_contents($svgFile);
}

// Fallback para o módulo (garante funcionamento em dev/developer mode)
if (empty($svgContent)) {
    $moduleSvg = BP . '/app/code/Nuvem/AtelieStudio/view/frontend/web/images/camadas/tenis-completo.svg';
    if (is_file($moduleSvg)) {
        $svgContent = (string) file_get_contents($moduleSvg);
    }
}
?>
<div id="atelie-studio-app"
     class="atelie-studio-wrapper"
     data-bind="scope: 'atelieStudio'">

    <div class="atelie-studio__stage">
        <?php if ($svgContent !== ''): ?>
            <div class="atelie-studio__svg"
                 role="img"
                 aria-label="<?= $escaper->escapeHtmlAttr(__('Pré-visualização do tênis personalizado')) ?>">
                <?= /* @noEscape */ $svgContent ?>
            </div>
        <?php else: ?>
            <p class="atelie-studio__svg-fallback">
                <?= $escaper->escapeHtml(__('Pré-visualização indisponível.')) ?>
            </p>
        <?php endif; ?>
    </div>

    <!-- ko template: getTemplate() --><!-- /ko -->
</div>

<script type="text/x-magento-init">
{
    "#atelie-studio-app": {
        "Magento_Ui/js/core/app": <?= /* @noEscape */ $jsLayout ?>
    }
}
</script>
