<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="sales.email.order.renderers">
            <block class="Magento\Sales\Block\Order\Email\Items\Order\DefaultOrder" name="sales.email.order.renderers.atelie" as="atelie"
                   template="Nuvem_AtelieSales::email/items/order.phtml">
                <block class="Magento\Framework\View\Element\Template"
                       name="sales.email.order.renderers.atelie.ficha" as="atelie_ficha"
                       template="Nuvem_AtelieSales::email/items/ficha.phtml">
                    <arguments>
                        <argument name="view_model" xsi:type="object">Nuvem\AtelieSales\ViewModel\Order\ItemOptions</argument>
                    </arguments>
                </block>
            </block>
        </referenceBlock>
    </body>
</page>
