<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="catalog_product_view_type_atelie"/>
    <body>
        <referenceBlock name="product.info.addtocart" remove="true"/>
        <referenceBlock name="product.info.addtocart.additional" remove="true"/>
        <referenceBlock name="product.price.final" remove="true"/>
        <referenceContainer name="content">
            <block class="Magento\Theme\Block\Html\Title" name="atelie.cart.edit.context"
                   template="Magento_Theme::html/title.phtml"
                   before="atelie.studio.container" cacheable="false">
                <arguments>
                    <argument name="id" xsi:type="string">atelie-cart-edit-title</argument>
                </arguments>
                <action method="setPageTitle">
                    <argument name="pageTitle" xsi:type="string" translate="true">Editar tênis do carrinho</argument>
                </action>
                <block class="Magento\Framework\View\Element\Template" name="atelie.cart.edit.description"
                       template="Nuvem_AtelieSales::cart/item/edit-context.phtml"/>
            </block>
        </referenceContainer>
    </body>
</page>
