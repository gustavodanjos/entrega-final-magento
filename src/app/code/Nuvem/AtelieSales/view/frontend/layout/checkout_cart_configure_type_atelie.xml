<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="catalog_product_view_type_atelie"/>
    <body>
        <referenceBlock name="product.info.addtocart" remove="true"/>
        <referenceBlock name="product.info.addtocart.additional" remove="true"/>
        <referenceBlock name="product.price.final" remove="true"/>
        <referenceContainer name="content">
            <block class="Magento\Framework\View\Element\Template" name="atelie.cart.configure.private"
                   cacheable="false"/>
        </referenceContainer>
    </body>
</page>
