<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="Nuvem\AtelieSales\Api\ComponentStockInterface"
                type="Nuvem\AtelieSales\Model\ProvisionalComponentStock"/>
    <preference for="Nuvem\Atelie\Api\PriceCalculatorInterface"
                type="Nuvem\AtelieSales\Model\PriceCalculator"/>
    <type name="Magento\Framework\Webapi\ServiceInputProcessor">
        <plugin name="nuvem_atelie_sales_strip_tampered_price"
                type="Nuvem\AtelieSales\Plugin\Webapi\StripTamperedPricePlugin"/>
    </type>
    <type name="Magento\Checkout\Model\Cart\ImageProvider">
        <plugin name="nuvem_atelie_sales_preview_image"
                type="Nuvem\AtelieSales\Plugin\Checkout\Model\Cart\PreviewImageProvider"/>
    </type>
</config>