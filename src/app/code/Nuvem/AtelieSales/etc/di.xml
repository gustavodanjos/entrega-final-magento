<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="Nuvem\AtelieSales\Api\ComponentStockInterface"
                type="Nuvem\AtelieSales\Model\ComponentStock"/>
    <preference for="Nuvem\Atelie\Api\PriceCalculatorInterface"
                type="Nuvem\AtelieSales\Model\PriceCalculator"/>
    <type name="Magento\Catalog\Model\Product\Type">
        <plugin name="nuvem_atelie_sales_price_model"
                type="Nuvem\AtelieSales\Plugin\Catalog\Product\Type\PriceModelPlugin"
                sortOrder="10"/>
    </type>
    <type name="Magento\Framework\Webapi\ServiceInputProcessor">
        <plugin name="nuvem_atelie_sales_strip_tampered_price"
                type="Nuvem\AtelieSales\Plugin\Webapi\StripTamperedPricePlugin"/>
    </type>
    <type name="Magento\Quote\Model\QuoteManagement">
        <plugin name="nuvem_atelie_sales_compensate_failed_submission"
                type="Nuvem\AtelieSales\Plugin\QuoteManagement\CompensateFailedSubmission"/>
    </type>
</config>
