<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">

    <table name="nuvem_atelie_movimentacao" resource="default" engine="innodb"
           comment="Razão do estoque: toda mudança gera uma linha">
        <column xsi:type="bigint" name="movimentacao_id" padding="20" unsigned="true"
                nullable="false" identity="true" comment="PK"/>
        <column xsi:type="int" name="componente_id" padding="10" unsigned="true"
                nullable="false" comment="FK componente"/>
        <column xsi:type="varchar" name="tipo" nullable="false" length="16"
                comment="reserva, compensacao, devolucao, ajuste"/>
        <column xsi:type="int" name="quantidade" padding="10" nullable="false"
                comment="Negativo sai, positivo volta"/>
        <column xsi:type="int" name="quote_id" padding="10" unsigned="true"
                nullable="true" comment="Quote"/>
        <column xsi:type="int" name="order_id" padding="10" unsigned="true"
                nullable="true" comment="Order"/>
        <column xsi:type="int" name="order_item_id" padding="10" unsigned="true"
                nullable="true" comment="Order item"/>
        <column xsi:type="varchar" name="observacao" nullable="true" length="255"
                comment="Observação"/>
        <column xsi:type="timestamp" name="created_at" nullable="false"
                default="CURRENT_TIMESTAMP" comment="Criado em"/>

        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="movimentacao_id"/>
        </constraint>
        <constraint xsi:type="foreign"
                    referenceId="NUVEM_ATELIE_MOV_COMPONENTE_ID"
                    table="nuvem_atelie_movimentacao" column="componente_id"
                    referenceTable="nuvem_atelie_componente" referenceColumn="componente_id"
                    onDelete="CASCADE"/>

        <index referenceId="NUVEM_ATELIE_MOV_COMPONENTE_ID" indexType="btree">
            <column name="componente_id"/>
        </index>
        <index referenceId="NUVEM_ATELIE_MOV_ORDER_ID" indexType="btree">
            <column name="order_id"/>
        </index>
    </table>
</schema>