<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Catalog\Helper\Product\ConfigurationPool">
        <arguments>
            <argument name="instancesByType" xsi:type="array">
                <item name="atelie" xsi:type="object">Nuvem\AtelieSales\Helper\Catalog\Product\Configuration</item>
            </argument>
        </arguments>
    </type>
    <type name="Magento\Checkout\CustomerData\ItemPool">
        <arguments>
            <argument name="itemMap" xsi:type="array">
                <item name="atelie" xsi:type="string">Nuvem\AtelieSales\CustomerData\AtelieItem</item>
            </argument>
        </arguments>
    </type>
    <type name="Magento\Checkout\Controller\Cart\UpdateItemOptions">
        <plugin name="nuvem_atelie_update_options_response"
                type="Nuvem\AtelieSales\Plugin\Checkout\Controller\Cart\UpdateOptionsResponse"/>
    </type>
    <type name="Magento\Checkout\CustomerData\Cart">
        <plugin name="nuvem_atelie_cart_section" type="Nuvem\AtelieSales\Plugin\Checkout\CartSection"/>
    </type>
    <type name="Nuvem\AtelieStudio\ViewModel\Estudio">
        <plugin name="nuvem_atelie_studio_edit_data" type="Nuvem\AtelieSales\Plugin\Checkout\StudioEditData"/>
    </type>
    <type name="Magento\Quote\Model\Quote">
        <plugin name="nuvem_atelie_update_item_in_place" type="Nuvem\AtelieSales\Plugin\Quote\UpdateItemInPlace"/>
    <type name="Magento\Sales\Block\Order\Item\Renderer\DefaultRenderer">
        <plugin name="nuvem_atelie_sales_historical_item_options"
                type="Nuvem\AtelieSales\Plugin\Sales\ItemOptions"/>
        <plugin name="nuvem_atelie_sales_plain_option_text"
                type="Nuvem\AtelieSales\Plugin\Sales\OptionText"/>
    </type>
</config>
