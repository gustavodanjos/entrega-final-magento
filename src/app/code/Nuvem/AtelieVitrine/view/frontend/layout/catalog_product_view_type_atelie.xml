<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="atelie.studio.container">
            <arguments>
                <argument name="jsLayout" xsi:type="array">
                    <item name="components" xsi:type="array">
                        <item name="atelieStudio" xsi:type="array">
                            <item name="children" xsi:type="array">
                                <item name="saveCreation" xsi:type="array">
                                    <item name="component" xsi:type="string">Nuvem_AtelieVitrine/js/save-creation</item>
                                    <item name="displayArea" xsi:type="string">creationActions</item>
                                    <item name="imports" xsi:type="array">
                                        <item name="configuration" xsi:type="string">${ $.parentName }:creationConfiguration</item>
                                        <item name="studioData" xsi:type="string">${ $.parentName }:studioData</item>
                                    </item>
                                    <item name="config" xsi:type="array">
                                        <item name="template" xsi:type="string">Nuvem_AtelieVitrine/save-creation</item>
                                    </item>
                                </item>
                            </item>
                        </item>
                    </item>
                </argument>
            </arguments>
        </referenceBlock>
    </body>
</page>
