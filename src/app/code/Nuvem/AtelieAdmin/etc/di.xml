<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Nuvem\Atelie\Api\ComponentRepositoryInterface">
        <plugin name="nuvem_atelieadmin_component_invalidate_cache"
                type="Nuvem\AtelieAdmin\Plugin\Component\InvalidateCache"/>
    </type>

    <type name="Nuvem\Atelie\Model\RuleRepository">
        <plugin name="nuvem_atelieadmin_rule_invalidate_cache"
                type="Nuvem\AtelieAdmin\Plugin\Rule\InvalidateCache"/>
    </type>
    <type name="Magento\Framework\Console\CommandList">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="nuvem_atelie_stock_set" xsi:type="object">Nuvem\AtelieAdmin\Console\Command\SetStock</item>
                <item name="nuvem_atelie_stock_show" xsi:type="object">Nuvem\AtelieAdmin\Console\Command\ShowStock</item>
            </argument>
        </arguments>
    </type>
    <preference for="Nuvem\Atelie\Api\AtelieCatalogInterface"
                type="Nuvem\AtelieAdmin\Model\Catalog\CachedCatalog"/>
    <virtualType name="NuvemAtelieProductionGridCollection"
                 type="Magento\Framework\View\Element\UiComponent\DataProvider\SearchResult">
        <arguments>
            <argument name="mainTable" xsi:type="string">nuvem_atelie_ficha</argument>
            <argument name="resourceModel" xsi:type="string">Nuvem\AtelieAdmin\Model\ResourceModel\Production</argument>
            <argument name="identifierName" xsi:type="string">ficha_id</argument>
        </arguments>
    </virtualType>
    <virtualType name="NuvemAtelieComponentGridCollection"
                 type="Magento\Framework\View\Element\UiComponent\DataProvider\SearchResult">
        <arguments>
            <argument name="mainTable" xsi:type="string">nuvem_atelie_componente</argument>
            <argument name="resourceModel" xsi:type="string">Nuvem\Atelie\Model\ResourceModel\Component</argument>
            <argument name="identifierName" xsi:type="string">componente_id</argument>
        </arguments>
    </virtualType>
    <type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
        <arguments>
            <argument name="collections" xsi:type="array">
                <item name="nuvem_atelie_production_listing_data_source" xsi:type="string">NuvemAtelieProductionGridCollection</item>
                <item name="nuvem_atelie_component_listing_data_source" xsi:type="string">NuvemAtelieComponentGridCollection</item>
            </argument>
        </arguments>
    </type>
</config>
