    <h1><?= $escaper->escapeHtml(__('Ficha de produção #%1', $sheet['ficha_id'])) ?></h1>
    <dl class="nuvem-production-sheet__details">
        <dt><?= $escaper->escapeHtml(__('Pedido')) ?></dt>
        <dd><?= $escaper->escapeHtml((string) ($snapshot['order_increment_id'] ?? $sheet['order_id'])) ?></dd>
        <dt><?= $escaper->escapeHtml(__('Item do pedido')) ?></dt>
