<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="logo">
            <arguments>
                <argument name="logo_file" xsi:type="string">images/logo-nuvem-atelie.svg</argument>
            </arguments>
        </referenceBlock>

        <referenceBlock name="catalog.topnav" remove="true"/>
        <referenceBlock name="store.menu">
            <block class="Magento\Framework\View\Element\Template"
                   name="nuvem.topnav"
                   template="Magento_Theme::html/topmenu.phtml">
                <block class="Magento\Cms\Block\BlockByIdentifier" name="nuvem.navigation">
                    <arguments>
                        <argument name="identifier" xsi:type="string">nuvem-menu</argument>
                    </arguments>
                </block>
            </block>
        </referenceBlock>

        <referenceContainer name="page.wrapper">
            <container name="nuvem.lavanda.bar"
                       htmlTag="div"
                       htmlClass="nuvem-lavanda-bar"
                       before="header.container"
                       label="Faixa Lavanda Nuvem">
                <block class="Magento\Cms\Block\BlockByIdentifier" name="nuvem.lavanda.bar.mensagem">
                    <arguments>
                        <argument name="identifier" xsi:type="string">nuvem-aviso-topo</argument>
                    </arguments>
                </block>
            </container>
        </referenceContainer>

        <referenceContainer name="footer">
            <block class="Magento\Theme\Block\Html\Footer"
                   name="nuvem.footer"
                   template="Magento_Theme::html/footer.phtml"
                   before="-"/>
        </referenceContainer>
        <move element="footer_links" destination="nuvem.footer"/>
        <referenceBlock name="store_switcher" remove="true"/>
        <referenceBlock name="copyright" remove="true"/>
    </body>
</page>
