<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="logo">
            <arguments>
                <argument name="logo_file" xsi:type="string">images/logo-nuvem-atelie.svg</argument>
            </arguments>
        </referenceBlock>

        <referenceContainer name="page.wrapper">
            <container name="nuvem.lavanda.bar"
                       htmlTag="div"
                       htmlClass="nuvem-lavanda-bar"
                       before="header.container"
                       label="Faixa Lavanda Nuvem">
                <block class="Magento\Cms\Block\BlockByIdentifier" name="nuvem.lavanda.bar.mensagem">
                    <arguments>
                        <argument name="identifier" xsi:type="string">nuvem-aviso-topo</argument>
                    </arguments>
                </block>
            </container>
        </referenceContainer>

    </body>
</page>
